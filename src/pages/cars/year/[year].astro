---
import cars from "../../../assets/cars.json";
import Layout from "../../../layouts/Layout.astro";
import PlotFigure from "../../../components/PlotFigure.astro";
import * as Plot from "@observablehq/plot";

export const prerender = false;

const { year } = Astro.params;
const filteredCars = cars.filter((car) => car.year.toString() === year);
const years = [...new Set(cars.map((car) => car.year))].sort((a, b) => a - b);
const nextYear = years[years.indexOf(Number(year)) + 1];

const plotOptions = {
  grid: true,
  marks: [
    Plot.dot(filteredCars, {
      x: "weight (lb)",
      y: "power (hp)",
      fill: "steelblue",
      r: 4,
      fillOpacity: 0.7,
    }),
  ],
  x: {
    label: "Poids (lb)",
  },
  y: {
    label: "Puissance (hp)",
  },
  title: `Relation Puissance vs Poids - Voitures ${year}`,
};

export async function getStaticPaths() {
  return [
    { params: { year: "72" } },
    { params: { year: "76" } },
  ];
}
---

<Layout>
  <h1 class="m-3 text-2xl font-bold">Voitures de l'année {year}</h1>
  <p class="m-3 text-lg">{filteredCars.length} voiture(s) trouvée(s) pour l'année {year}</p>

  <div class="m-3">
    <PlotFigure options={plotOptions} />
  </div>

  {
    nextYear !== undefined && (
      <a
        href={`/cars/year/${nextYear}`}
        class="m-3 inline-block rounded bg-green-800 px-4 py-2 text-white hover:bg-green-700"
      >
        Graphique suivant ({nextYear})
      </a>
    )
  }
</Layout>
