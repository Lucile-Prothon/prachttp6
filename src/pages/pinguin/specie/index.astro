---
import penguins from "../../../assets/penguins.json";
import Layout from "../../../layouts/Layout.astro";

const species = [...new Set(penguins.map((penguin) => penguin.species))].sort();
---

<Layout>
  <h1 class="m-3 text-2xl font-bold">Pingouins par espèce</h1>
  <ul class="m-3 flex list-none flex-wrap gap-3 p-0">
    {
      species.map((specie) => (
        <li>
          <a
            href={`/pinguin/specie/${encodeURIComponent(specie)}`}
            class="inline-block rounded bg-green-800 px-4 py-2 text-white hover:bg-green-700"
          >
            {specie}
          </a>
        </li>
      ))
    }
  </ul>
</Layout>
